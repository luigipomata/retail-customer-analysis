# Copia questo file in ".env" e valorizza le variabili per il tuo ambiente.
# Il file ".env" NON va versionato su Git (vedi .gitignore).

# Nome (o host\istanza) del server SQL Server, es: MIOPC\SQLEXPRESS oppure localhost
SQL_SERVER=

# Nome del database applicativo
SQL_DATABASE=RetailAnalysis

# "yes" per autenticazione di Windows (Trusted Connection).
# Se "no", impostare anche SQL_USERNAME e SQL_PASSWORD.
SQL_TRUSTED_CONNECTION=yes

# Driver ODBC installato sulla macchina (es: "ODBC Driver 18 for SQL Server",
# "ODBC Driver 17 for SQL Server")
SQL_DRIVER=ODBC Driver 18 for SQL Server

# Da valorizzare solo se SQL_TRUSTED_CONNECTION=no
SQL_USERNAME=
SQL_PASSWORD=
